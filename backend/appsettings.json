{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "change-me",
    "Issuer": "Flower2Flower",
    "Audience": "Flower2Flower-Frontend",
    "ExpiryMinutes": 15
  },
  "Fast2Sms": {
    "BaseUrl": "https://www.fast2sms.com",
    "ApiKey": "your_fast2sms_api_key",
    "OtpTemplateId": "your_otp_template_id",
    "OtpExpiryMinutes": 5,
    "OtpLength": 6
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "Length": 6
  },
  "AllowedFrontendOrigins": "http://localhost:3000,https://localhost:3000",
  "ASPNETCORE_ENVIRONMENT": "Development"
}
